# Keşke Alsaydım — ortam değişkenleri
# Bu dosyayı `.env.local` olarak kopyalayıp değerleri doldurun.
# Üretimde tüm değişkenler Vercel proje ayarlarından tanımlanır.

# ── Veritabanı (zorunlu) ─────────────────────────────────────────────────────
# Neon pgbouncer bağlantı dizesi. Yerelde Docker Postgres de kullanılabilir.
# Alternatif olarak POSTGRES_URL veya PGHOST + PGDATABASE + PGUSER de okunur.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/keskealsaydim?sslmode=disable
# Havuzdaki azami bağlantı sayısı (varsayılan 4; serverless için düşük tutun).
DB_MAX_CONNS=4

# ── Kimlik doğrulama (zorunlu) ───────────────────────────────────────────────
# HMAC SHA256 imzalama anahtarı. EN AZ 32 karakter olmalı, yoksa API 500 döner.
# Üretim için: openssl rand -base64 48
JWT_SECRET=

# ── Önbellek (opsiyonel ama üretimde şiddetle önerilir) ──────────────────────
# Upstash Redis REST kimlik bilgileri. Tanımlanmazsa önbellek devre dışı kalır
# ve fiyat/arama uçları her istekte Yahoo'ya gider; hız sınırı da kapalı olur.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── CORS ─────────────────────────────────────────────────────────────────────
# Üretim frontend adresi. Virgülle ayırarak birden fazla origin verilebilir.
# Aynı origin üzerinden servis edildiğinde (Vercel) boş bırakılabilir.
FRONTEND_URL=

# ── Frontend (Vite) ──────────────────────────────────────────────────────────
# API taban adresi. Vercel'de aynı origin kullanıldığı için boş bırakın.
# Yerelde Vite proxy'si /api'yi 3000 portuna yönlendirir; yine boş kalabilir.
VITE_API_URL=
